{
  "name": "madar",
  "private": true,
  "version": "1.8.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:single": "vite build --config vite.single.config.ts",
